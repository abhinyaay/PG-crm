# Copy to terraform.tfvars (git-ignored) and fill in. Contains no secrets - every credential is
# generated by Terraform (random_password) or by RDS, or written out-of-band (JWT key pair).

aws_account_id    = "123456789012"       # REQUIRED: the production account
region            = "ap-south-1"
dr_region         = "ap-southeast-1"
github_repository = "your-org/pgms"      # REQUIRED: owner/repo allowed to deploy

domain_name               = "app.example.com" # REQUIRED: SPA + /api + /analytics share this origin
subject_alternative_names = []
route53_zone_id           = null # set to auto-validate the certificate and create the alias record
certificate_arn           = null # or bring an existing ACM certificate

alarm_email_addresses = ["oncall@example.com"]

# Image tags used when Terraform registers task definitions (first apply). Afterwards CI owns the
# image; see README "How CI uses the outputs".
image_tags = {
  backend   = "0123456789ab"
  analytics = "0123456789ab"
  frontend  = "0123456789ab"
}

# Cost levers (see README "Cost notes")
nat_gateway_mode           = "per_az" # "single" saves ~2 NAT gateways
enable_interface_endpoints = true
analytics_use_fargate_spot = false
create_read_replica        = true

enable_cross_region_backups = false
enable_bootstrap_admin      = true # set false after the first SUPER_ADMIN has logged in
bootstrap_admin_email       = "admin@example.com"
