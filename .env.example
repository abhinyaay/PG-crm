# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- PostgreSQL ---
POSTGRES_ADMIN_USER=pgms_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin
APP_DB_PASSWORD=change-me-app
ANALYTICS_DB_PASSWORD=change-me-analytics

# --- Redis ---
REDIS_PASSWORD=change-me-redis

# --- JWT (RS256) ---
# Leave empty locally to use an ephemeral key pair (single backend instance only).
# Generate a persistent pair with: ./scripts/generate-jwt-keys.sh >> .env
APP_JWT_PRIVATE_KEY=
APP_JWT_PUBLIC_KEY=
APP_JWT_ALLOW_EPHEMERAL_KEYS=true

# --- First platform admin (created only if no SUPER_ADMIN exists) ---
APP_BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeMe123

# --- Demo data (profile "demo"): password for all generated demo accounts ---
# SPRING_PROFILES_ACTIVE=docker,demo
SPRING_PROFILES_ACTIVE=docker
APP_DEMO_PASSWORD=Demo12345

APP_CORS_ORIGINS=http://localhost:3000

# --- Host ports (change if they clash with other local services) ---
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
ANALYTICS_HOST_PORT=8000
NGINX_HOST_PORT=80
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025

# --- Observability (docker-compose.observability.yml; `make observability-up` generates the password) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_HOST_PORT=58301
GRAFANA_HOST_PORT=58302
PROMETHEUS_RETENTION=15d

# --- Backups (scripts/backup-db.sh) ---
BACKUP_RETENTION_DAYS=14
APP_JWT_KEY_ID=pgms-key-1

# --- Notifications (email: smtp|log, SMS: log|twilio|msg91) ---
APP_NOTIFICATIONS_EMAIL_PROVIDER=smtp
APP_MAIL_FROM=no-reply@pgms.local
APP_MAIL_FROM_NAME=PG Manager
APP_PORTAL_URL=http://localhost
APP_NOTIFICATIONS_SMS_PROVIDER=log
APP_SMS_LOG_CONTENT=true
# Twilio (set APP_NOTIFICATIONS_SMS_PROVIDER=twilio)
APP_TWILIO_ACCOUNT_SID=
APP_TWILIO_AUTH_TOKEN=
APP_TWILIO_FROM_NUMBER=
# MSG91 / India DLT (set APP_NOTIFICATIONS_SMS_PROVIDER=msg91); per-type DLT ids: SMS_DLT_<TYPE>=
APP_MSG91_AUTH_KEY=
APP_MSG91_SENDER_ID=
