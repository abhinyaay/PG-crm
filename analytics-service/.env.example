# Analytics service configuration (placeholders only - never commit real credentials).
# Read-only role with SELECT on the analytics.* views only.
DATABASE_URL=postgresql+psycopg://analytics_ro:CHANGE_ME@postgres:5432/pgms
# Same Redis as the backend (token revocation markers) - also used for the result cache.
REDIS_URL=redis://redis:6379/0
JWKS_URL=http://backend:8080/api/v1/auth/jwks
JWT_ISSUER=pgms-auth
JWT_AUDIENCE=pgms-api
BUSINESS_TIMEZONE=Asia/Kolkata
CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO
# Comma-separated list; leave empty when the SPA is served through the same nginx origin.
CORS_ORIGINS=http://localhost:5173
